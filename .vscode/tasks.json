{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Inventory Related Workspaces",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/workspace_inventory.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
