{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Inventory Related Workspaces",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/workspace_inventory.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare Prompt",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/prepare_prompt.py",
        "${input:preparePromptMode}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Daily Project Briefing",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/daily_briefing.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run Verifier Tests",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "tests/test_repo_smoke.py",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "OCHRE Bridge",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/ochre_bridge.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "preparePromptMode",
      "type": "pickString",
      "description": "Select prompt mode",
      "options": [
        "TRANSLATE",
        "SAUCE",
        "POLISH",
        "ELABORATE"
      ],
      "default": "TRANSLATE"
    }
  ]
}
